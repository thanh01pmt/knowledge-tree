{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project_graph.schema.v3.json",
  "title": "Project Graph — Canonical Schema v3",
  "description": "Canonical representation của một software project, đủ để Agent đi từ Source Code → hiểu sản phẩm → architecture → dependency → task → map Knowledge Tree. KHÔNG phải AST, KHÔNG phải Knowledge Tree, KHÔNG phải roadmap. Định nghĩa theo tài liệu thiết kế 8 domain + 2 lớp cross-cutting.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "product",
    "features",
    "capabilities",
    "architecture",
    "experience",
    "data_integration",
    "implementation",
    "validation",
    "evidence",
    "knowledge_mapping"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project": {
      "type": "object",
      "description": "01. Project Identity — root node",
      "required": [
        "id",
        "name",
        "purpose",
        "project_type",
        "platform",
        "tech_stack",
        "architecture",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "project_type": {
          "type": "string",
          "enum": [
            "mobile_app",
            "web_app",
            "cli_tool",
            "library_sdk",
            "desktop_app",
            "backend_service",
            "fullstack_app",
            "game",
            "design_tool",
            "ai_agent",
            "plugin_extension",
            "data_pipeline",
            "other"
          ],
          "description": "BẮT BUỘC: loại dự án (game/design_tool/ai_agent... có thể mở rộng)"
        },
        "purpose": {
          "type": "string",
          "description": "WHY — sản phẩm tồn tại vì sao"
        },
        "platform": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tech_stack": {
          "type": "object",
          "properties": {
            "language": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ui": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "persistence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "networking": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "other": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "architecture": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VD: ['MVVM']"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "scan_dir": {
              "type": "string",
              "description": "Thư mục app được phân tích (VD: DemoApp)"
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "description": "02. Product Graph — 'chúng ta đang xây sản phẩm gì'",
      "required": [
        "goals",
        "users",
        "journeys",
        "requirements"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Tham chiếu product.goals[].id"
              }
            }
          }
        },
        "journeys": {
          "type": "array",
          "description": "User Journey — chuỗi hành động từ User → Action → Screen → Outcome",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "steps"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "priority",
              "acceptance"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "priority": {
                "enum": [
                  "core",
                  "supporting",
                  "optional",
                  "polish"
                ]
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "completion_level": {
                "type": "string",
                "enum": [
                  "base",
                  "mvp",
                  "extend",
                  "polish"
                ],
                "description": "M3: mức hoàn thiện của requirement (cross-feature slicing). base=scaffold chạy được, mvp=walking skeleton, extend=thêm chức năng, polish=chất lượng."
              }
            }
          }
        },
        "scaffold": {
          "type": "object",
          "description": "M2: bước khởi tạo dự án — tạo từ template nền tảng, cấu trúc file sinh sẵn, build chạy được đầu tiên.",
          "properties": {
            "platform_template": {
              "type": "string",
              "description": "VD: Xcode iOS App template, Vite React template"
            },
            "generated_structure": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files template sinh sẵn (AppDelegate, ContentView, Assets...)"
            },
            "first_build": {
              "type": "string",
              "description": "Bước build chạy được đầu tiên"
            },
            "tooling_intro": {
              "type": "string",
              "description": "Làm quen công cụ (Xcode, simulator...)"
            }
          }
        },
        "development_stages": {
          "type": "array",
          "description": "NARRATIVE cross-feature phát triển: mô tả từng giai đoạn app phát triển từ tối thiểu đến hoàn thiện, kèm học gì để làm được. LLM sinh từ toàn bộ source + goal — KHÔNG phải công thức.",
          "items": {
            "type": "object",
            "required": ["stage", "product_state", "need", "learn"],
            "properties": {
              "stage": {
                "type": "string",
                "description": "Tên giai đoạn (VD 'Giai đoạn 1 — App chạy được UI cơ bản')"
              },
              "product_state": {
                "type": "string",
                "description": "Trạng thái sản phẩm ĐẠT ĐƯỢC ở cuối giai đoạn này (góc nhìn người dùng — app làm được gì)"
              },
              "need": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Các thứ cần triển khai (features/tasks cụ thể, VD 'scaffold', 'FirebaseAuth', 'RecentChatView')"
              },
              "learn": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Kiến thức/kỹ năng học để làm được giai đoạn này (VD 'SwiftUI View', '@StateObject', 'async auth flow')"
              },
              "validation": {
                "type": "string",
                "description": "Cách biết giai đoạn này hoàn thành (build chạy? user đăng nhập được? tin nhắn realtime?)"
              },
              "cross_feature_value": {
                "type": "string",
                "description": "Giá trị BỒI ĐẮP vào sản phẩm tổng thể (additive value) — sản phẩm sau giai đoạn này = sản phẩm trước + lớp mới gì"
              },
              "temporary_approach": {
                "type": "string",
                "description": "Scaffold TẠM phi tuyến (non-linearity) — giải pháp trung gian test nhanh không có trong kiến trúc cuối (VD 'tạm dùng UserDefaults lưu session để test, thay bằng FirebaseAuth ở giai đoạn 3')"
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "description": "03. Feature Graph — sản phẩm cần capability gì",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "priority",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "core",
              "supporting",
              "optional",
              "polish"
            ]
          },
          "status": {
            "enum": [
              "DISCOVERED",
              "PLANNED",
              "IN_PROGRESS",
              "IMPLEMENTED",
              "VALIDATED",
              "REFACTORED",
              "POLISHED"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "journey_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tham chiếu features[].id"
          },
          "api_usage": {
            "type": "array",
            "description": "A2: API/framework methods feature dùng (VD: ChatClient.connectUser, queryChannels, sendMessage). Learner học API cụ thể, không phải 'API Integration' chung."
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Cầu nối Feature → Task. Feature quá lớn, Task quá nhỏ.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "feature_id",
          "purpose",
          "depends_on",
          "produces"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "feature_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "description": "04. Architecture Graph — project được cấu tạo như thế nào. FACT vs INFERENCE tách bạch.",
      "required": [
        "pattern",
        "confidence",
        "evidence",
        "nodes",
        "edges"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VD: ['MVVM']"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VD: ['WeatherViewModel.swift', '@Observable']"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "layer",
              "responsibility",
              "evidence_type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "app",
                  "module",
                  "layer",
                  "service",
                  "repository",
                  "view_model",
                  "model",
                  "component",
                  "manager",
                  "utility"
                ]
              },
              "custom_type": {
                "type": "string",
                "description": "Khi project dùng architecture đặc biệt"
              },
              "layer": {
                "type": "string",
                "description": "presentation | domain | data | infra"
              },
              "responsibility": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "used_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_type": {
                "enum": [
                  "OBSERVED",
                  "INFERRED",
                  "GENERATED"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "edges": {
          "$ref": "#/definitions/edges"
        }
      }
    },
    "experience": {
      "type": "object",
      "description": "05. Experience / UI Graph",
      "required": [
        "screens",
        "components",
        "ui_states",
        "navigation"
      ],
      "properties": {
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "purpose",
              "entry_point"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "entry_point": {
                "type": "boolean"
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "VD: idle, loading, loaded, error"
              },
              "navigates_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A1: framework/property wrapper screen dùng (VD: '@State', 'NavigationStack')."
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "VD: reusable_view, container, cell"
              },
              "purpose": {
                "type": "string"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ui_states": {
          "type": "array",
          "description": "UI State Graph — quyết định Knowledge cần học (State, Binding, Async, Error handling)",
          "items": {
            "type": "object",
            "required": [
              "id",
              "owner",
              "triggered_by",
              "transitions_to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "owner": {
                "type": "string",
                "description": "Screen id"
              },
              "triggered_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "transitions_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger",
              "presentation"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "presentation": {
                "type": "string",
                "description": "VD: push, sheet, fullScreenCover, tab"
              }
            }
          }
        }
      }
    },
    "data_integration": {
      "type": "object",
      "description": "06. Data & Integration Graph",
      "required": [
        "data_flows",
        "models",
        "integrations",
        "persistence"
      ],
      "properties": {
        "data_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "flow"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "flow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "VD: [api, dto, mapper, model, repository, view_model]"
              }
            }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "properties"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "domain",
                  "dto",
                  "persistence",
                  "view_model"
                ]
              },
              "properties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "protocol",
              "operations"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "VD: rest_api, websocket, mqtt"
              },
              "protocol": {
                "type": "string",
                "description": "VD: HTTP, WebSocket, MQTT, WiFi"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "failure_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "technology",
              "entities"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "technology": {
                "type": "string",
                "description": "VD: SwiftData, CoreData, UserDefaults, File"
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "description": "07. Implementation Graph — learner phải LÀM gì, không phải code làm gì",
      "required": [
        "tasks",
        "task_dependencies"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability_id",
              "action",
              "modifies",
              "creates",
              "depends_on",
              "acceptance",
              "intent",
              "outcome",
              "source_evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "capability_id": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "description": "Action có thể thực hiện. KHÔNG phải 'Learn State' mà là 'Implement search query state'"
              },
              "modifies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Files bị sửa"
              },
              "creates": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Thứ được tạo (state, file, type...)"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Tham chiếu tasks[].id"
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "intent": {
                "type": "string",
                "description": "WHY — tại sao task này tồn tại (người dùng cần gì)"
              },
              "outcome": {
                "type": "object",
                "properties": {
                  "user_visible": {
                    "type": "string",
                    "description": "Sau task này sản phẩm thay đổi gì cho user"
                  },
                  "technical": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "source_evidence": {
                "type": "array",
                "description": "Reference implementation — file thật minh hoạ, KHÔNG phải task = tạo file đó",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A1: API/framework/property wrapper task dùng (VD: '@State', 'ChatClient', 'URLSession'). Cầu nối task → concept."
              },
              "concurrency": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A4: cơ chế async/concurrency dùng (VD: 'Task', 'DispatchQueue', 'async/await')."
              },
              "effort": {
                "type": "object",
                "description": "C3: ước lượng độ nặng task cho roadmap (số khái niệm, số file, thời gian ước tính).",
                "properties": {
                  "concepts_count": {
                    "type": "integer"
                  },
                  "files_touched": {
                    "type": "integer"
                  },
                  "estimated_minutes": {
                    "type": "integer"
                  }
                }
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
