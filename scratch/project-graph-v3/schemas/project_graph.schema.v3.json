{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project_graph.schema.v3.json",
  "title": "Project Graph — Canonical Schema v3",
  "description": "Canonical representation of a software project, enough for an Agent to go from Source Code → understand the product → architecture → dependencies → tasks → map to the Knowledge Tree. NOT an AST, NOT a Knowledge Tree, NOT a roadmap. Defined by the 8-domain design doc plus 2 cross-cutting layers.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "product",
    "features",
    "capabilities",
    "architecture",
    "experience",
    "data_integration",
    "implementation",
    "validation",
    "evidence",
    "knowledge_mapping"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project": {
      "type": "object",
      "description": "01. Project Identity — root node",
      "required": [
        "id",
        "name",
        "purpose",
        "project_type",
        "platform",
        "tech_stack",
        "architecture",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "project_type": {
          "type": "string",
          "enum": [
            "mobile_app",
            "web_app",
            "cli_tool",
            "library_sdk",
            "desktop_app",
            "backend_service",
            "fullstack_app",
            "game",
            "design_tool",
            "ai_agent",
            "plugin_extension",
            "data_pipeline",
            "other"
          ],
          "description": "REQUIRED: project type (game/design_tool/ai_agent... extensible)"
        },
        "purpose": {
          "type": "string",
          "description": "WHY — why the product exists"
        },
        "platform": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tech_stack": {
          "type": "object",
          "properties": {
            "language": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ui": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "persistence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "networking": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "other": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "architecture": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VD: ['MVVM']"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "scan_dir": {
              "type": "string",
              "description": "App directory analyzed (e.g. DemoApp)"
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "description": "02. Product Graph — 'what product are we building'",
      "required": [
        "goals",
        "users",
        "journeys",
        "requirements"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Reference to product.goals[].id"
              }
            }
          }
        },
        "journeys": {
          "type": "array",
          "description": "User Journey — chain of actions from User → Action → Screen → Outcome",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "steps"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "priority",
              "acceptance"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "priority": {
                "enum": [
                  "core",
                  "supporting",
                  "optional",
                  "polish"
                ]
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "completion_level": {
                "type": "string",
                "enum": [
                  "base",
                  "mvp",
                  "extend",
                  "polish"
                ],
                "description": "M3: completion level of the requirement (cross-feature slicing). base=runnable scaffold, mvp=walking skeleton, extend=add features, polish=quality."
              }
            }
          }
        },
        "scaffold": {
          "type": "object",
          "description": "M2: project initialization step — created from the platform template, generated file structure, first successful build.",
          "properties": {
            "platform_template": {
              "type": "string",
              "description": "VD: Xcode iOS App template, Vite React template"
            },
            "generated_structure": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Template-generated files (AppDelegate, ContentView, Assets...)"
            },
            "first_build": {
              "type": "string",
              "description": "First successful build step"
            },
            "tooling_intro": {
              "type": "string",
              "description": "Getting familiar with the tooling (Xcode, simulator...)"
            }
          }
        },
        "development_stages": {
          "type": "array",
          "description": "NARRATIVE cross-feature growth: describe each stage of the app evolving from minimal to complete, including what is learned to make it happen. LLM generates it from the whole source + goal — NOT a formula.",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "product_state",
              "need",
              "learn"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "description": "Stage name (e.g. 'Stage 1 — App runs with basic UI')"
              },
              "product_state": {
                "type": "string",
                "description": "Product state ACHIEVED at the end of this stage (user perspective — what the app can do)"
              },
              "need": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Things to implement (concrete features/tasks, e.g. 'scaffold', 'FirebaseAuth', 'RecentChatView')"
              },
              "learn": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Knowledge/skills to learn to complete this stage (e.g. 'SwiftUI View', '@StateObject', 'async auth flow')"
              },
              "validation": {
                "type": "string",
                "description": "How to know this stage is complete (build runs? user can sign in? realtime messages?)"
              },
              "cross_feature_value": {
                "type": "string",
                "description": "ADDITIVE value to the overall product — the product after this stage = previous product + which new layer"
              },
              "temporary_approach": {
                "type": "string",
                "description": "TEMPORARY non-linear scaffold — intermediate fast-test solution NOT in the final architecture (e.g. 'temporarily store the session with UserDefaults for testing, replaced by FirebaseAuth in stage 3')"
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "description": "03. Feature Graph — what capabilities the product needs",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "priority",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "core",
              "supporting",
              "optional",
              "polish"
            ]
          },
          "status": {
            "enum": [
              "DISCOVERED",
              "PLANNED",
              "IN_PROGRESS",
              "IMPLEMENTED",
              "VALIDATED",
              "REFACTORED",
              "POLISHED"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "journey_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reference to features[].id"
          },
          "api_usage": {
            "type": "array",
            "description": "A2: API/framework methods the feature uses (e.g. ChatClient.connectUser, queryChannels, sendMessage). The learner learns the specific API, not 'API Integration' in general."
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Bridge between Feature → Task. Features too big, tasks too small.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "feature_id",
          "purpose",
          "depends_on",
          "produces"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "feature_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "description": "04. Architecture Graph — how the project is structured. FACT vs INFERENCE kept separate.",
      "required": [
        "pattern",
        "confidence",
        "evidence",
        "nodes",
        "edges"
      ],
      "properties": {
        "pattern": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VD: ['MVVM']"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VD: ['WeatherViewModel.swift', '@Observable']"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "layer",
              "responsibility",
              "evidence_type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "app",
                  "module",
                  "layer",
                  "service",
                  "repository",
                  "view_model",
                  "model",
                  "component",
                  "manager",
                  "utility"
                ]
              },
              "custom_type": {
                "type": "string",
                "description": "When the project uses a special architecture"
              },
              "layer": {
                "type": "string",
                "description": "presentation | domain | data | infra"
              },
              "responsibility": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "used_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_type": {
                "enum": [
                  "OBSERVED",
                  "INFERRED",
                  "GENERATED"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "edges": {
          "$ref": "#/definitions/edges"
        }
      }
    },
    "experience": {
      "type": "object",
      "description": "05. Experience / UI Graph",
      "required": [
        "screens",
        "components",
        "ui_states",
        "navigation"
      ],
      "properties": {
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "purpose",
              "entry_point"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "entry_point": {
                "type": "boolean"
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "VD: idle, loading, loaded, error"
              },
              "navigates_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A1: framework/property wrapper the screen uses (e.g. '@State', 'NavigationStack')."
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "VD: reusable_view, container, cell"
              },
              "purpose": {
                "type": "string"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ui_states": {
          "type": "array",
          "description": "UI State Graph — determines the Knowledge to learn (State, Binding, Async, Error handling)",
          "items": {
            "type": "object",
            "required": [
              "id",
              "owner",
              "triggered_by",
              "transitions_to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "owner": {
                "type": "string",
                "description": "Screen id"
              },
              "triggered_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "transitions_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger",
              "presentation"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "presentation": {
                "type": "string",
                "description": "VD: push, sheet, fullScreenCover, tab"
              }
            }
          }
        }
      }
    },
    "data_integration": {
      "type": "object",
      "description": "06. Data & Integration Graph",
      "required": [
        "data_flows",
        "models",
        "integrations",
        "persistence"
      ],
      "properties": {
        "data_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "flow"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "flow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "VD: [api, dto, mapper, model, repository, view_model]"
              }
            }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "properties"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "domain",
                  "dto",
                  "persistence",
                  "view_model"
                ]
              },
              "properties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "protocol",
              "operations"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "VD: rest_api, websocket, mqtt"
              },
              "protocol": {
                "type": "string",
                "description": "VD: HTTP, WebSocket, MQTT, WiFi"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "failure_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "technology",
              "entities"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "technology": {
                "type": "string",
                "description": "VD: SwiftData, CoreData, UserDefaults, File"
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "description": "07. Implementation Graph — what the learner must DO, not what the code does",
      "required": [
        "tasks",
        "task_dependencies"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability_id",
              "action",
              "modifies",
              "creates",
              "depends_on",
              "acceptance",
              "intent",
              "outcome",
              "source_evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "capability_id": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "description": "An action that can be performed. NOT 'Learn State' but 'Implement search query state'"
              },
              "modifies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Files modified"
              },
              "creates": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What is created (state, file, type...)"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Reference to tasks[].id"
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "intent": {
                "type": "string",
                "description": "WHY — why this task exists (what the user needs)"
              },
              "outcome": {
                "type": "object",
                "properties": {
                  "user_visible": {
                    "type": "string",
                    "description": "What changes in the product for the user after this task"
                  },
                  "technical": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "source_evidence": {
                "type": "array",
                "description": "Reference implementation — the real file that illustrates it, NOT 'task = create that file'",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A1: API/framework/property wrapper the task uses (e.g. '@State', 'ChatClient', 'URLSession'). Bridge from task → concept."
              },
              "concurrency": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "A4: async/concurrency mechanisms used (e.g. 'Task', 'DispatchQueue', 'async/await')."
              },
              "effort": {
                "type": "object",
                "description": "C3: task workload estimate for the roadmap (concept count, file count, estimated time).",
                "properties": {
                  "concepts_count": {
                    "type": "integer"
                  },
                  "files_touched": {
                    "type": "integer"
                  },
                  "estimated_minutes": {
                    "type": "integer"
                  }
                }
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "M3: requirements this task implements (e.g. ['RQ1','RQ3']) — used to determine completion_level (base/mvp/extend/polish)"
              }
            }
          }
        },
        "task_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "type",
              "reason"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "BLOCKED_BY",
                  "DEPENDS_ON",
                  "ENABLES",
                  "FOLLOWS",
                  "LEARNING_DEPENDENCY",
                  "CODE_DEPENDENCY"
                ],
                "description": "LEARNING_DEPENDENCY = pedagogical prerequisite (knowledge learner needs first — component trước form, model trước logic). CODE_DEPENDENCY = compile-time/structural only (WelcomeView NavigationLink cần LoginView — cần để compile, nhưng học WelcomeView trước với placeholder). DEPENDS_ON = legacy không phân loại (STEP 4 xử lý như CODE_DEPENDENCY)."
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "missing_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature_id": {
                "type": "string"
              },
              "gap": {
                "type": "string",
                "description": "What code is MISSING (missing error handling, missing tests, hardcoded values)"
              },
              "suggested_lo": {
                "type": "string"
              }
            }
          },
          "description": "C1: gaps in the reference code — the roadmap should teach fixing them rather than only reproducing."
        },
        "tech_debt": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string"
              },
              "issue": {
                "type": "string",
                "description": "e.g. file too large, deeply nested logic, duplicated code"
              },
              "suggested_phase": {
                "type": "string",
                "description": "VD: POLISH"
              }
            }
          },
          "description": "C2: tech debt signals — goes to the Polish/refactor phase."
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "08. Validation Graph",
      "required": [
        "validations",
        "quality_requirements"
      ],
      "properties": {
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "target",
              "criteria",
              "method"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "description": "Task/capability id"
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "method": {
                "type": "array",
                "items": {
                  "enum": [
                    "manual",
                    "unit_test",
                    "ui_test"
                  ]
                }
              }
            }
          }
        },
        "quality_requirements": {
          "type": "array",
          "description": "Functional/Performance/Accessibility/Security/Reliability/UX/Maintainability — mostly in Polish",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "requirement"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "functional",
                  "performance",
                  "accessibility",
                  "security",
                  "reliability",
                  "ux",
                  "maintainability"
                ]
              },
              "requirement": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Cross-cutting layer — Evidence / Source Traceability. Every inference must have evidence.",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target_id",
              "source",
              "evidence_type"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "description": "Node id being evidenced"
              },
              "source": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "string",
                    "description": "VD: '12-27'"
                  },
                  "symbol": {
                    "type": "string"
                  }
                }
              },
              "evidence_type": {
                "enum": [
                  "OBSERVED",
                  "INFERRED",
                  "GENERATED"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "extraction_method": {
                "type": "string",
                "description": "VD: source_analysis, git_tracker, LLM_inference"
              }
            }
          }
        }
      }
    },
    "knowledge_mapping": {
      "type": "object",
      "description": "Cross-cutting layer — Knowledge Mapping. Bridge to the Knowledge Tree. The Agent must NOT arbitrarily create new concepts.",
      "properties": {
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "project_node",
              "keywords",
              "concepts"
            ],
            "properties": {
              "project_node": {
                "type": "string",
                "description": "Task/Capability/Symbol id"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "VD: ['@State']"
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Reference to Knowledge Tree concept codes"
              },
              "status": {
                "enum": [
                  "MAPPED",
                  "UNMAPPED_CONCEPT"
                ],
                "description": "UNMAPPED → review queue"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "edges": {
      "type": "array",
      "description": "Canonical edge types — do not use a vague 'related_to'",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "CONTAINS",
              "PART_OF",
              "REQUIRES",
              "DEPENDS_ON",
              "BLOCKED_BY",
              "ENABLES",
              "IMPLEMENTS",
              "REALIZES",
              "USES",
              "PROVIDES",
              "CONSUMES",
              "NAVIGATES_TO",
              "UPDATES",
              "READS",
              "WRITES",
              "CREATES",
              "MODIFIES",
              "PRODUCES",
              "VALIDATED_BY",
              "SATISFIES",
              "MAPS_TO",
              "EVIDENCED_BY"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}